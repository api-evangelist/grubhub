          "name": "Grubhub Confirm an Order",
          "request": {
            "name": "Grubhub Confirm an Order",
            "description": {
              "content": "Confirms an order that has been received. All orders that can be fulfilled are required to be confirmed. Partners can optionally indicate an estimated delivery time using wait_time_in_minutes in the request body.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchant",
                ":merchant_long_id",
                "orders",
