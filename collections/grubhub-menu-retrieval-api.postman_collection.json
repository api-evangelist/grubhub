          "request": {
            "name": "Grubhub Retrieve Current Merchant Menu",
            "description": {
              "content": "Retrieves the current menu for a merchant as a PosNormalizedMenu object. The returned menu can be edited and re-ingested to update the merchant's menu on the Grubhub platform.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchant",
                ":merchant_id",
                "ingestion",
                "menu"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "merchant_id",
                  "description": "(Required) The unique identifier for the merchant on Grubhub."
                }
              ]
            },
