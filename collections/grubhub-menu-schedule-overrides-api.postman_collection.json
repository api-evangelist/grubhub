          "request": {
            "name": "Grubhub Update Menu Schedule Overrides",
            "description": {
              "content": "Creates or updates menu schedule overrides for a merchant. Schedule overrides allow temporary changes to menu availability, such as making certain items unavailable during specific time periods.",
              "type": "text/plain"
            },
