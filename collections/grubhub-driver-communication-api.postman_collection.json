          "name": "Grubhub Create Proxy Courier Phone Number",
          "request": {
            "name": "Grubhub Create Proxy Courier Phone Number",
            "description": {
              "content": "Generates a masked proxy phone number that creates a bridge between the merchant's phone number and the courier's phone number. This protects both parties' actual phone numbers while enabling direct communication. Best practice is to call this endpoint as needed rather than caching the result.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchant",
                ":merchant_long_id",
                "orders",
                ":order_uuid",
                "delivery",
                "proxy-phone"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "merchant_long_id",
                  "description": "(Required) The long-form unique identifier for the merchant on Grubhub."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "order_uuid",
                  "description": "(Required) The UUID of the order."
