                  "key": "status",
                  "value": "<string>",
                  "description": "Filter orders by their current status."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "Start of the date range filter in ISO 8601 format."
                },
                {
