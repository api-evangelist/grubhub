      "id": "4a708494-3f04-4f54-b071-373db3b10337",
      "name": "Merchant Status",
      "description": {
        "content": "Endpoints for managing merchant online/offline status on Grubhub, including soft and hard pauses.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "94442739-bb01-4ef2-ab38-57e5f872fc2c",
          "name": "Grubhub Update Merchant Online/offline Status",
          "request": {
            "name": "Grubhub Update Merchant Online/offline Status",
            "description": {
              "content": "Sets the status of a batch of merchants to online or offline on Grubhub. When offline, merchants will not be listed on the site. When online, merchants will be listed and able to accept orders. Supports both soft pauses (remainder of business day) and hard pauses (multiple days).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchants",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchants\": [\n    {\n      \"merchant_id\": \"<string>\",\n      \"status\": \"<string>\",\n      \"pause_type\": \"<string>\"\n    },\n    {\n      \"merchant_id\": \"<string>\",\n      \"status\": \"<string>\",\n      \"pause_type\": \"<string>\"\n    }\n  ]\n}",
