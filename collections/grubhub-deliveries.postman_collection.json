          "id": "250932ce-9dbd-48e2-a493-65c3601a2f56",
          "name": "Grubhub Create Proxy Courier Phone Number",
          "request": {
            "name": "Grubhub Create Proxy Courier Phone Number",
            "description": {
              "content": "Generates a masked proxy phone number that creates a bridge between the merchant's phone number and the courier's phone number. This protects both parties' actual phone numbers while enabling direct communication. Best practice is to call this endpoint as needed rather than caching the result.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchant",
                ":merchant_long_id",
                "orders",
