          "id": "6a458967-7dd9-48d9-a7b4-34e9f179ab06",
          "name": "Grubhub Get Delivery Status for an Order",
          "request": {
            "name": "Grubhub Get Delivery Status for an Order",
            "description": {
              "content": "Retrieves the current state of a delivery for an order, including driver contact information, driver arrival ETAs, driver latitude and longitude coordinates, and delivery lifecycle state. Partners can use this to provide real-time delivery tracking to merchants.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pos",
                "v1",
                "merchant",
                ":merchant_long_id",
                "orders",
                ":order_uuid",
                "delivery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "merchant_long_id",
                  "description": "(Required) The long-form unique identifier for the merchant on Grubhub."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "order_uuid",
                  "description": "(Required) The UUID of the order."
